---
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import { themeBootScript } from '../scripts/theme';
import { localePath } from '../i18n';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';

export interface Props {
  locale: 'ru' | 'en';
  title: string;
  description: string;
  altPath: string;
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ruUrl = new URL(localePath('ru', path), Astro.site);
const enUrl = new URL(localePath('en', path), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript} />
    <link rel="preload" href={locale === 'ru' ? onestCyrillic : onestLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {analyticsSrc && <script is:inline defer src={analyticsSrc} data-domain={analyticsDomain} data-website-id={analyticsDomain} />}
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ruUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
