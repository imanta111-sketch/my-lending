---
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import { themeBootScript } from '../scripts/theme';
import { localePath } from '../i18n';

export interface Props {
  locale: 'ru' | 'en';
  title: string;
  description: string;
  altPath: string;
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ruUrl = new URL(localePath('ru', path), Astro.site);
const enUrl = new URL(localePath('en', path), Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ruUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
