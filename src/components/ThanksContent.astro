---
import SimplePage from './SimplePage.astro';
import { getDict, localePath, type Locale } from '../i18n';
import { links } from '../data/contacts';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).thanks;
---
<SimplePage locale={locale} path="/thanks" title={t.title} noindex>
  <h1>{t.title}</h1>
  <p class="lead">{t.text}</p>
  <div class="actions">
    <a class="btn-primary" href={localePath(locale, '/')}>{t.back}</a>
    <a class="btn-secondary" href={links.instagram} rel="me noopener">Instagram</a>
  </div>
</SimplePage>
<style>
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
</style>
