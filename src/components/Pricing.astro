---
import { getDict, type Locale } from '../i18n';
import Faq from './Faq.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).pricing;
---
<section id="pricing" class="section">
  <div class="container">
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <p class="banner">{t.banner}</p>
    <ul class="plans">
      {t.plans.map((p) => (
        <li class:list={['plan', 'reveal', { popular: p.popular === 'yes' }]} data-plan>
          {p.popular === 'yes' && <span class="badge mono">{t.popular}</span>}
          <h3>{p.name}</h3>
          <p class="price mono" data-price>€{p.priceFrom}–{p.priceTo}</p>
          <p class="visually-hidden">{t.includes}</p>
          <ul class="includes">
            {p.includes.map((i) => <li>{i}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="muted">{t.note}</p>
    <a class="btn-primary" href="#contact">{t.cta}</a>
    <Faq locale={locale} />
  </div>
</section>
<style>
  .banner {
    display: inline-block; margin-top: var(--space-2); padding: .75rem 1.25rem; max-width: none;
    border-radius: var(--radius-sm); border: 1px dashed var(--accent-text); color: var(--text);
  }
  .plans {
    list-style: none; margin: var(--space-4) 0 var(--space-3); padding: 0;
    display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }
  .plan { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4) var(--space-3) var(--space-3); }
  .plan.popular { border: 2px solid var(--accent-text); }
  .badge { position: absolute; top: -.85rem; left: var(--space-3); background: var(--accent); color: var(--accent-contrast); padding: .25rem .75rem; border-radius: 999px; font-size: .8125rem; }
  .price { font-size: 1.5rem; font-weight: 600; color: var(--text); margin: var(--space-1) 0 var(--space-2); }
  .includes { margin: 0; padding-left: 1.1rem; display: grid; gap: .375rem; }
  .includes li::marker { color: var(--accent-text); }
</style>
