---
import { Image } from 'astro:assets';
import { getDict, type Locale } from '../i18n';
import { works } from '../data/works';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).works;
---
<section id="showcase" class="section">
  <div class="container">
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul class="rows">
      {works.map((w) => (
        <li class="row reveal" data-work={w.id}>
          <Image class="shot" src={w.image} alt="" width={640} height={420} loading="lazy" />
          <div class="body">
            <h3>{w.title[locale]}</h3>
            {locale === 'en' && w.newTab && <p class="meta">{t.langNote}</p>}
            <p class="muted">{w.description[locale]}</p>
            {w.newTab
              ? <a class="btn-secondary" href={w.href} target="_blank" rel="noopener">{t.open}</a>
              : <a class="btn-secondary" href={w.href}>{t.howBuilt}</a>}
          </div>
        </li>
      ))}
    </ul>
    <p class="bridge"><a class="text-link" href="#contact">{t.bridge}</a></p>
  </div>
</section>
<style>
  .rows { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
  /* Полосы во всю ширину, снимок и текст меняются сторонами — вместо решётки одинаковых карточек. */
  .row {
    display: grid; gap: var(--space-3) var(--space-5); align-items: center;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row:nth-child(even) .shot { grid-column: 2; grid-row: 1; }
  .row:nth-child(even) .body { grid-column: 1; grid-row: 1; }
  .shot {
    width: 100%; height: auto; aspect-ratio: 640 / 420;
    object-fit: cover; object-position: top center;
    border-radius: var(--radius); border: 1px solid var(--border);
  }
  .body p { margin: 0 0 var(--space-2); max-width: 46ch; }
  .body h3 { margin-bottom: var(--space-1); }
  .body .btn-secondary { margin-inline: 0; margin-top: var(--space-1); }
  .bridge { margin-top: var(--space-4); }
  @media (max-width: 48rem) {
    .row { grid-template-columns: 1fr; padding-block: var(--space-4); }
    .row:nth-child(even) .shot,
    .row:nth-child(even) .body { grid-column: 1; grid-row: auto; }
  }
</style>
