---
import { Image } from 'astro:assets';
import photo from '../assets/me.png';
import { getDict, type Locale } from '../i18n';
import { links } from '../data/contacts';
interface Props { locale: Locale }
const t = getDict(Astro.props.locale).hero;
---
<section id="hero" class="hero container">
  <div class="copy">
    <p class="eyebrow mono">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="lead">{t.subtitle}</p>
    <div class="actions">
      <a class="btn-primary" href="#contact">{t.cta}</a>
      <a class="btn-secondary" href="#showcase">{t.secondary}</a>
    </div>
    <a class="text-link" href={links.instagram} rel="me noopener">{t.follow}</a>
    <p class="trust mono muted">{t.trust}</p>
  </div>
  <Image class="photo" src={photo} alt={t.imageAlt} width={480} densities={[1, 2]} loading="eager" fetchpriority="high" />
</section>
<style>
  .hero {
    display: grid; gap: var(--space-4); align-items: center;
    padding-block: clamp(2.5rem, 8vw, 6rem);
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-3) var(--space-1); }
  .trust { margin-top: var(--space-3); }
  .photo { width: 100%; border-radius: var(--radius); }
  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; }
    .photo { max-width: 22rem; }
  }
</style>
