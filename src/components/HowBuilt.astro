---
import { getDict, type Locale } from '../i18n';
interface Props { locale: Locale }
const t = getDict(Astro.props.locale).howBuilt;
---
<section id="how-built" class="section how">
  <div class="container">
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul class="list">
      {t.items.map((item) => (
        <li class="item reveal">
          <h3>{item.title}</h3>
          <p class="muted">{item.text}</p>
          <a class="text-link" href={item.href} target="_blank" rel="noopener">{t.link}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .how { background: var(--surface); border-block: 1px solid var(--border); }
  .list {
    list-style: none; margin: var(--space-4) 0 0; padding: 0;
    display: grid; gap: var(--space-3) var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  }
  .item p { margin: 0; }
</style>
