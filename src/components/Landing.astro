---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Showcase from './Showcase.astro';
import Process from './Process.astro';
import HowBuilt from './HowBuilt.astro';
import About from './About.astro';
import { getDict, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const home = localePath(locale, '/');
const altPath = localePath(locale === 'ru' ? 'en' : 'ru', '/');
---
<Base locale={locale} title={t.meta.title} description={t.meta.description} altPath={altPath}>
  <Header locale={locale} altPath={altPath} home={home} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Showcase locale={locale} />
    <Process locale={locale} />
    <HowBuilt locale={locale} />
    <About locale={locale} />
    {['pricing', 'contact'].map((id) => (
      <section id={id} class="section"><div class="container"><h2>{id}</h2></div></section>
    ))}
  </main>
  <Footer locale={locale} home={home} privacyPath={localePath(locale, '/privacy')} />
</Base>
